+  // Ask Hyprland directly. Quickshell's workspace.hasFullscreen can go stale
+  // (seen: Hyprland reports fullscreen while it says false), and a probe that
+  // is already running ignores running=true, so events queue a re-run, and a
+  // slow resync catches anything missed.
+  property bool fullscreenProbePending: false
+  function probeFullscreen() {
+    if (fullscreenProbe.running) { fullscreenProbePending = true; return }
+    fullscreenProbe.running = true
+  }
+  Process {
+    id: fullscreenProbe
+    running: true
+    command: ["bash", "-c", "hyprctl -j activeworkspace | jq -r '.hasfullscreen'"]
+    stdout: SplitParser { onRead: function(line) {
+      var v = String(line).trim() === "true"
+      root.fullscreenActive = v
+    } }
+    onExited: if (root.fullscreenProbePending) {
+      root.fullscreenProbePending = false
+      Qt.callLater(root.probeFullscreen)
+    }
+  }
+  Timer {
+    id: fullscreenEventDelay
+    interval: 60
+    onTriggered: root.probeFullscreen()
+  }
+  Timer {
+    interval: 1500
+    repeat: true
+    running: true
+    onTriggered: root.probeFullscreen()
+  }
+  Connections {
+    target: Hyprland
+    function onRawEvent(event) {
+      var n = event.name
+      if (n === "fullscreen" || n === "workspace" || n === "workspacev2" || n === "focusedmon" || n === "focusedmonv2" || n === "activewindowv2" || n === "closewindow" || n === "movewindow" || n === "movewindowv2")
+        fullscreenEventDelay.restart()
+    }
+  }
+  Timer {
+    id: fsPeekHideTimer
+    interval: 350
+    onTriggered: if (root.hotEdgeHoverCount === 0 && root.fsBarHoverCount === 0) root.fsPeek = false
+  }
+
+  // Safety net: hover enter/leave events can still go missing (surface
+  // remaps, layer changes). While peeking, check where the cursor really is;
+  // if it's clearly away from the bar, clear the stale tallies and hide.
+  Timer {
+    id: fsPeekVerifyTimer
+    interval: 400
+    repeat: true
+    running: root.fullscreenActive && root.fsPeek
+    onTriggered: if (!cursorProbe.running) cursorProbe.running = true
+  }
+  Process {
+    id: cursorProbe
+    command: ["bash", "-c", "p=$(hyprctl cursorpos | tr -d ,); set -- $p; hyprctl -j monitors | jq -r --argjson x $1 --argjson y $2 '.[] | select($x >= .x and $x < .x + .width/.scale and $y >= .y and $y < .y + .height/.scale) | \"\\($x - .x) \\($y - .y) \\(.width/.scale) \\(.height/.scale)\"' | head -n1"]
+    stdout: SplitParser { onRead: function(line) {
+      var v = String(line).trim().split(/\s+/).map(Number)
+      if (v.length < 4 || v.some(isNaN)) return
+      var x = v[0], y = v[1], w = v[2], h = v[3]
+      var band = root.barSize + 6
+      var near = root.position === "top" ? y <= band
+               : root.position === "bottom" ? y >= h - band
+               : root.position === "left" ? x <= band
+               : x >= w - band
+      if (near || !root.fsPeek) return
+      root.hotEdgeHoverCount = 0
+      root.barHoverCount = 0
+      root.fsBarHoverCount = 0
+      centerSectionRevealTimer.restart()
+      fsPeekHideTimer.stop()
+      root.fsPeek = false
+    } }
+  }
+  onFsBarHoverCountChanged: {
+    if (!fullscreenActive) return
+    if (fsBarHoverCount > 0) { fsPeek = true; fsPeekHideTimer.stop() } else fsPeekHideTimer.restart()
+  }
+  onHotEdgeHoverCountChanged: {
+    if (!fullscreenActive) return
+    if (hotEdgeHoverCount > 0) { fsPeek = true; fsPeekHideTimer.stop() } else fsPeekHideTimer.restart()
+  }
+
+  component HotEdgePanel: PanelWindow {
+    id: hotEdge
+    // Stays mapped while peeking. Unmapping it the moment it was hovered meant
