+
+double KineticState::launchVelocity(const SAxis& ax, uint32_t liftMs) const {
+    if (ax.samples.empty())
+        return 0.0;
+
+    const uint32_t last = ax.samples.back().timeMs;
+
+    // "scroll, pause, lift" must not fling.
+    if (liftMs > last && liftMs - last > STALE_TAIL_MS)
+        return 0.0;
+
+    // Sum the movement of the reports inside the window, and divide by the time that
+    // movement actually spans: from the report *before* the first included one up to the
+    // last. Dividing by a fixed window would over-count by one report interval, so a 60 Hz
+    // pad would fling ~20% harder than a 125 Hz one at the same finger speed.
+    double sum   = 0.0;
+    size_t first = ax.samples.size();
+    for (size_t i = ax.samples.size(); i-- > 0;) {
+        if (ax.samples.size() - i > VELOCITY_QUEUE_SIZE || last - ax.samples[i].timeMs >= VELOCITY_RELEVANCE_MS)
+            break;
+        sum += ax.samples[i].delta;
+        first = i;
+    }
+
+    double spanMs;
+    if (first > 0)
+        spanMs = last - ax.samples[first - 1].timeMs;
+    else if (ax.samples.size() > 1)
+        spanMs = (last - ax.samples[0].timeMs) * ax.samples.size() / (ax.samples.size() - 1.0); // no earlier report: assume the average interval
+    else
+        spanMs = 16.0;
+
+    spanMs = std::max(spanMs, 1.0);
+    return sum / spanMs * *m_cfg.deltaMultiplier;
+}
