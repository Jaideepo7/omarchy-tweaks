--- a/Bar.qml
+++ b/Bar.qml
@@ -1826,6 +1826,148 @@
 
     HoverHandler { id: moduleHover }
 
+    // Hover-to-open: resting the pointer on a module that owns a panel for
+    // half a second opens it, as a click would. A panel opened this way also
+    // closes by itself once the pointer has left both the icon and the panel,
+    // unless something inside the panel was pressed first.
+    property bool hoverSession: false
+    property var cardProbe: null
+    property real cursorX: 0
+    property real cursorY: 0
+    property bool cursorKnown: false
+    property int hoverAwayTicks: 0
+
+    // The popup a bar widget owns: the first nested object that looks like a
+    // KeyboardPanel / PopupCard (it has a card to put content in).
+    function findPopup(obj, depth) {
+      if (!obj || depth > 6) return null
+      var kids = []
+      var lists = []
+      try { lists.push(obj.data) } catch (e1) {}
+      try { lists.push(obj.children) } catch (e2) {}
+      for (var l = 0; l < lists.length; l++) {
+        var list = lists[l]
+        if (list === undefined || list === null) continue
+        try {
+          for (var i = 0; i < list.length; i++) kids.push(list[i])
+        } catch (e3) {}
+      }
+      try { if (obj.item) kids.push(obj.item) } catch (e4) {}
+      for (var k = 0; k < kids.length; k++) {
+        var c = kids[k]
+        if (!c) continue
+        var isPopup = false
+        try { isPopup = "anchorItem" in c && "contentItem" in c && "open" in c && "bar" in c } catch (e5) {}
+        if (isPopup) return c
+        var found = findPopup(c, depth + 1)
+        if (found) return found
+      }
+      return null
+    }
+
+    function attachProbes() {
+      var popup = findPopup(slot.activeItem, 0)
+      if (!popup || !popup.contentItem || popup.contentItem.length < 1) return false
+      var holder = popup.contentItem[0].parent
+      var card = holder ? holder.parent : null
+      if (!card) return false
+      if (!cardProbe || cardProbe.parent !== card) cardProbe = probeComponent.createObject(card)
+      slot.popupRef = popup
+      return !!cardProbe
+    }
+    property var popupRef: null
+
+    // The open panel covers the bar with a full-screen layer, so the icon
+    // stops seeing hover, and that layer only learns where the pointer is once
+    // it moves. Ask Hyprland where the cursor is instead.
+    function pointerOnIcon() {
+      if (slot.hovered || !cursorKnown) return true
+      var w = root.slotWindow(slot)
+      if (!w || !w.screen || !w.contentItem) return true
+      var at = slot.mapToItem(w.contentItem, 0, 0)
+      var x = w.screen.x + at.x, y = w.screen.y + at.y
+      if (root.position === "bottom") y += w.screen.height - w.height
+      else if (root.position === "right") x += w.screen.width - w.width
+      return cursorX >= x - 2 && cursorX <= x + slot.width + 2 && cursorY >= y - 2 && cursorY <= y + slot.height + 2
+    }
+
+    Process {
+      id: cursorProc
+      command: ["hyprctl", "cursorpos", "-j"]
+      stdout: StdioCollector {
+        onStreamFinished: {
+          try {
+            var c = JSON.parse(text)
+            slot.cursorX = c.x
+            slot.cursorY = c.y
+            slot.cursorKnown = true
+          } catch (e) {}
+        }
+      }
+    }
+
+    function endHoverSession() {
+      hoverSession = false
+      hoverAwayTicks = 0
+    }
+
+    Component {
+      id: probeComponent
+      Item {
+        id: probe
+        property bool pressed: false
+        readonly property bool hovered: probeHover.hovered
+        anchors.fill: parent
+        z: 1000
+        HoverHandler { id: probeHover }
+        TapHandler {
+          acceptedButtons: Qt.AllButtons
+          onPressedChanged: if (pressed) probe.pressed = true
+        }
+      }
+    }
+
+    Timer {
+      id: hoverOpenTimer
+      interval: 500
+      repeat: false
+      onTriggered: {
+        var item = slot.activeItem
+        if (!slot.hovered || modulePointer.dragging || !item) return
+        if (typeof item.open !== "function" || typeof item.close !== "function") return
+        if (item.opened === undefined || item.opened === true) return
+        item.open()
+        slot.hoverAwayTicks = 0
+        slot.cursorKnown = false
+        slot.hoverSession = true
+        if (slot.cardProbe) slot.cardProbe.pressed = false
+      }
+    }
+
+    Timer {
+      interval: 120
+      repeat: true
+      running: slot.hoverSession
+      onTriggered: {
+        var item = slot.activeItem
+        if (!item || item.opened !== true) { slot.endHoverSession(); return }
+        if (!slot.attachProbes()) return
+        if (!cursorProc.running) cursorProc.running = true
+        if (slot.cardProbe.pressed) { slot.endHoverSession(); return }
+        if (slot.pointerOnIcon() || slot.cardProbe.hovered) { slot.hoverAwayTicks = 0; return }
+        slot.hoverAwayTicks++
+        if (slot.hoverAwayTicks >= 3) {
+          slot.endHoverSession()
+          item.close()
+        }
+      }
+    }
+
+    onHoveredChanged: {
+      if (hovered) hoverOpenTimer.restart()
+      else hoverOpenTimer.stop()
+    }
+
     BorderSurface {
       visible: slot.dragSource
       anchors.fill: parent
