# Let PCI devices runtime-suspend when idle. The kernel default is
# power/control=on (never suspend), which kept the SD reader, Wi-Fi, NVMe, sensor
# hub etc. awake on battery. Devices whose drivers lack runtime PM just ignore it.
# USB is left alone (Omarchy manages USB autosuspend; input devices drop keys).
# Revert: delete /etc/udev/rules.d/99-pci-runtime-pm.rules and reboot.
ACTION=="add", SUBSYSTEM=="pci", ATTR{power/control}="auto"
